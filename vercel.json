{
  "version": 2,
  "name": "vitrine-online",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/cliente/:path*",
      "destination": "/cliente/:path*"
    },
    {
      "source": "/assets/:path*",
      "destination": "/cliente/assets/:path*"
    },

    /* 🔥 ROTA DINÂMICA - SEMPRE POR ÚLTIMO */
    {
      "source": "/:lojaId",
      "destination": "/cliente/index.html"
    }
  ]
}
